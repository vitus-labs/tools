{
  "name": "@vitus-labs/tools-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pre-configured tooling for development",
  "author": "Vit Bokisch <vit@bokisch.com>",
  "license": "MIT",
  "homepage": "https://github.com/vitus-labs/tools#readme",
  "repository": "git@github.com:vitus-labs/tools.git",
  "bugs": {
    "url": "https://github.com/vitus-labs/tools/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "node scripts/publish.js",
    "release:approve": "node scripts/approve-release-runs.js",
    "pkgs:clean": "rm -rf node_modules/ bun.lock && bun install",
    "pkgs:build": "bun run --filter '*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitus-labs/tools-storybook": "workspace:*",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "shell-quote": ">=1.8.4",
    "proxy-addr": ">=2.0.8"
  }
}
