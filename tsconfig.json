{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "pretty": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "scripts/**/*.js"
  ]
}
